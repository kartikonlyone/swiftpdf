# ---------------------------------------------------------------------------
# CORE
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.swiftpdf.example
NEXT_PUBLIC_SITE_NAME=SwiftPDF
NODE_ENV=development

# ---------------------------------------------------------------------------
# DATABASE (PostgreSQL + Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/swiftpdf?schema=public"

# ---------------------------------------------------------------------------
# AUTH (NextAuth / Auth.js)
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# FILE STORAGE (Cloudflare R2 — S3-compatible — or AWS S3)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=r2            # "r2" | "s3" | "none"
STORAGE_ENDPOINT=              # required for R2, e.g. https://<account_id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=swiftpdf-files
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=       # only if you serve a public CDN in front of the bucket
FILE_RETENTION_HOURS=24

# ---------------------------------------------------------------------------
# EMAIL (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="SwiftPDF <noreply@swiftpdf.example>"

# ---------------------------------------------------------------------------
# PAYMENTS (Razorpay)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# ANALYTICS (Google Analytics 4)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=      # stringified service-account JSON, server-side only

# ---------------------------------------------------------------------------
# GOOGLE SEARCH CONSOLE
# ---------------------------------------------------------------------------
# GSC_SITE_URL and *_SERVICE_ACCOUNT_JSON below feed the Admin > Analytics
# dashboard's Search Console report. NEXT_PUBLIC_GSC_VERIFICATION is a
# separate, simpler thing: the ownership-verification meta tag Google gives
# you when you add a property in Search Console (Settings > Ownership
# verification > HTML tag > copy just the content="..." value here).
NEXT_PUBLIC_GSC_VERIFICATION=
GSC_SITE_URL=
GSC_SERVICE_ACCOUNT_JSON=      # stringified service-account JSON, server-side only

# ---------------------------------------------------------------------------
# GOOGLE ADSENSE
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT_ID=      # e.g. ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_ACCOUNT_ID=
ADSENSE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# OCR
# ---------------------------------------------------------------------------
OCR_PROVIDER=tesseract          # "tesseract" | "none"

# ---------------------------------------------------------------------------
# CONVERSION WORKER (LibreOffice-based, for Office <-> PDF)
# ---------------------------------------------------------------------------
CONVERSION_WORKER_URL=           # e.g. http://conversion-worker.internal:4000
CONVERSION_WORKER_TOKEN=

# ---------------------------------------------------------------------------
# SECURITY
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
